# ---------------------------------------------------------------------------
# Banco de dados (PostgreSQL) — Neon, Supabase, Vercel Postgres ou equivalente
# ---------------------------------------------------------------------------
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Alguns provedores (Neon, Supabase) oferecem uma URL sem pgBouncer para
# migrations. Se existir, informe aqui — caso contrário pode ser omitida.
DIRECT_URL=""

# ---------------------------------------------------------------------------
# Autenticação do painel administrativo
# ---------------------------------------------------------------------------
# Segredo usado para assinar a sessão (JWT). Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-aleatorio-com-no-minimo-32-caracteres"

# Duração da sessão em dias (opcional, padrão 7)
AUTH_SESSION_DAYS="7"

# ---------------------------------------------------------------------------
# Usuário administrador inicial (usado por `npm run db:seed` e `npm run create:admin`)
# ---------------------------------------------------------------------------
ADMIN_EMAIL="admin@restaurante.com"
ADMIN_PASSWORD="troque-esta-senha"
ADMIN_NAME="Administrador"

# ---------------------------------------------------------------------------
# Upload de imagens — Vercel Blob
# Crie um Blob Store no painel da Vercel e copie o token de leitura/escrita.
# Sem este token o painel continua funcionando: o administrador pode informar
# a URL de uma imagem hospedada externamente.
# ---------------------------------------------------------------------------
BLOB_READ_WRITE_TOKEN=""

# Tamanho máximo de upload em MB (opcional, padrão 8)
UPLOAD_MAX_MB="8"

# ---------------------------------------------------------------------------
# URL pública do site (usada em metadados / OpenGraph)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

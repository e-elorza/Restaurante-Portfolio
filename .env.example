# ===========================================================================
# OBRIGATÓRIAS
# ===========================================================================

# Banco de dados PostgreSQL (Neon, Supabase, Vercel Postgres ou equivalente).
# As tabelas são criadas sozinhas durante o deploy.
DATABASE_URL="postgresql://usuario:senha@host:5432/banco?sslmode=require"

# Segredo que assina a sessão do painel. Gere com: openssl rand -base64 32
AUTH_SECRET="troque-por-um-segredo-aleatorio-com-no-minimo-32-caracteres"

# ===========================================================================
# RECOMENDADAS
# ===========================================================================

# Conexão direta com o banco, sem pooler. Neon e Supabase oferecem as duas:
# a aplicação usa a DATABASE_URL (com pooler) e as migrations usam esta.
# Se você conectar o banco por uma integração da Vercel, não precisa preencher
# nem esta nem a DATABASE_URL: o projeto encontra sozinho a conexão criada pela
# integração, inclusive quando ela usa um prefixo personalizado.
DIRECT_URL=""

# Envio de imagens pelo painel. Crie um Blob Store na Vercel (Storage → Blob):
# ao conectar ao projeto, a variável é criada automaticamente lá.
# Sem ela o painel continua funcionando — o administrador cola a URL de uma
# imagem já hospedada em vez de enviar o arquivo.
BLOB_READ_WRITE_TOKEN=""

# Endereço final do site, usado em metadados, OpenGraph e sitemap.
# Na Vercel isso é detectado sozinho; preencha ao usar domínio próprio.
NEXT_PUBLIC_SITE_URL=""

# ===========================================================================
# OPCIONAIS
# ===========================================================================

# Duração da sessão do painel, em dias (padrão 7).
AUTH_SESSION_DAYS="7"

# Tamanho máximo de cada arquivo enviado, em MB (padrão 8).
UPLOAD_MAX_MB="8"

# Usados apenas por `npm run db:seed` e `npm run create:admin`, na linha de
# comando. No site publicado o primeiro acesso é criado pela própria tela de
# login, então estas variáveis não são necessárias na Vercel.
ADMIN_EMAIL="admin@restaurante.com"
ADMIN_PASSWORD="troque-esta-senha"
ADMIN_NAME="Administrador"
